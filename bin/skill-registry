#!/usr/bin/env bash
set -euo pipefail

SKILL_REGISTRY_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_DIR="$(pwd)"
SKILLS_DIR="$SKILL_REGISTRY_HOME/skills"
TEMPLATE_FILE="$SKILL_REGISTRY_HOME/templates/codex-prompt.md"
OUTPUT_FILE="/tmp/skill-registry-codex-prompt.md"

usage() {
  cat <<'USAGE'
Usage:
  skill-registry <mode> "<task>"

Examples:
  skill-registry coder "Implement Gmail ingestion retry"
  skill-registry security "Review Google OAuth token storage"
  skill-registry architect "Design source/storage abstraction"
  skill-registry marketing "Research positioning for NotesCombine"
USAGE
}

available_modes() {
  find "$SKILLS_DIR" -maxdepth 1 -type f -name '*.md' ! -name 'core.md' -print \
    | sed 's#.*/##' \
    | sed 's#\.md$##' \
    | sort
}

read_project_context() {
  local files=(
    "AGENTS.md"
    ".ai/project-context.md"
    ".ai/architecture.md"
    ".ai/data-privacy.md"
    ".ai/coding-style.md"
  )

  local found=0
  local file
  for file in "${files[@]}"; do
    if [ -f "$PROJECT_DIR/$file" ]; then
      found=1
      printf '### %s\n\n' "$file"
      cat "$PROJECT_DIR/$file"
      printf '\n\n'
    fi
  done

  if [ "$found" -eq 0 ]; then
    printf 'No project context files found.\n'
  fi
}

render_prompt() {
  local mode="$1"
  local task="$2"
  local mode_file="$SKILLS_DIR/$mode.md"

  ACTIVE_SKILLS_CONTENT="$(printf '### Core\n\n%s\n\n### %s\n\n%s\n' "$(cat "$SKILLS_DIR/core.md")" "$mode" "$(cat "$mode_file")")" \
  PROJECT_CONTEXT_CONTENT="$(read_project_context)" \
  TASK_CONTENT="$task" \
  perl -0pe '
    s/\{\{PROJECT_CONTEXT\}\}/$ENV{PROJECT_CONTEXT_CONTENT}/g;
    s/\{\{ACTIVE_SKILLS\}\}/$ENV{ACTIVE_SKILLS_CONTENT}/g;
    s/\{\{TASK\}\}/$ENV{TASK_CONTENT}/g;
  ' "$TEMPLATE_FILE"
}

mode="${1:-}"
if [ "$#" -gt 0 ]; then
  shift
fi
task="$*"

if [ -z "$mode" ]; then
  usage
  exit 1
fi

if [ -z "$task" ]; then
  usage
  exit 1
fi

mode_file="$SKILLS_DIR/$mode.md"
if [ ! -f "$mode_file" ]; then
  echo "Unknown mode: $mode" >&2
  echo "Available modes:" >&2
  available_modes >&2
  exit 1
fi

render_prompt "$mode" "$task" > "$OUTPUT_FILE"

if ! command -v pbcopy >/dev/null 2>&1; then
  echo "Prompt saved to $OUTPUT_FILE, but pbcopy is not available." >&2
  exit 1
fi

if ! pbcopy < "$OUTPUT_FILE"; then
  echo "Prompt saved to $OUTPUT_FILE, but pbcopy failed." >&2
  exit 1
fi

printf 'Copied %s prompt for %s to clipboard: %s\n' "$mode" "$PROJECT_DIR" "$OUTPUT_FILE"
